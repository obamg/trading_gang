# TradeCore production environment — formationdouane.online
# Copy to .env.production and fill in values. Never commit .env.production.
#
# Deploy:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ── Postgres ──
POSTGRES_USER=tradecore
POSTGRES_PASSWORD=CHANGE_ME          # strong random password
POSTGRES_DB=tradecore

# ── Secrets ──
# Generate each with: openssl rand -hex 32
JWT_SECRET=
APP_SECRET_KEY=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (https://myaccount.google.com/apppasswords) ──
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@formationdouane.online
EMAIL_FROM_NAME=TradeCore
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Market Data ──
# CoinGecko free tier (https://www.coingecko.com/en/api/pricing)
COINGECKO_API_KEY=
# Whale Alert (https://whale-alert.io/signup)
WHALE_ALERT_API_KEY=
# TradingEconomics (https://tradingeconomics.com/analytics/api.aspx)
TRADING_ECONOMICS_API_KEY=

# ── Binance (free, no key needed for public streams) ──
BINANCE_STREAMS_ENABLED=true

# ── Telegram (https://t.me/BotFather) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false

# ── Optional modules ──
# All default to false in docker-compose.prod.yml. Flip to true to enable.
# WalletWatch: smart-money DEX swap tracker (needs whale_entities seeded)
WALLETWATCH_ENABLED=false
WALLETWATCH_MIN_USD=25000
# Discovery: PnL-based wallet leaderboard (depends on WalletWatch data)
DISCOVERY_ENABLED=false
# ListingWatch: Bybit Innovation Zone + new-listing detection
LISTINGWATCH_ENABLED=false
# Awakening: detects sleeping perps spiking off their 7d baseline
AWAKENING_ENABLED=false
# WaveWatch: continuous surveillance of Bybit Innovation Zone perps —
# fires "wave incoming" alerts when accumulation + range-break confirm
WAVEWATCH_ENABLED=false
